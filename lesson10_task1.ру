pets = {}

name = input("Введите имя питомца: ")
pet_type = input("Введите вид питомца: ")
age = int(input("Введите возраст питомца: "))
owner = input("Введите имя владельца: ")

pets[name] = {
    "Вид питомца": pet_type,
    "Возраст питомца": age,
    "Имя владельца": owner
}

pet_name = list(pets.keys())[0]
pet_info = list(pets.values())[0]

if pet_info["Возраст питомца"] % 10 == 1 and pet_info["Возраст питомца"] % 100 != 11:
    age_word = "год"
elif pet_info["Возраст питомца"] % 10 in [2, 3, 4] and pet_info["Возраст питомца"] % 100 not in [12, 13, 14]:
    age_word = "года"
else:
    age_word = "лет"

print(
    f'Это {pet_info["Вид питомца"]} по кличке "{pet_name}". '
    f'Возраст питомца: {pet_info["Возраст питомца"]} {age_word}. '
    f'Имя владельца: {pet_info["Имя владельца"]}'
)