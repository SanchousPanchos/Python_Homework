import random

import time

import json


# Проверка границ поля

def is_inside(x, y, width, height):

    return 0 <= x < width and 0 <= y < height

# Сохранение игры

def save_game():

    game_data = {

        "field": field,

        "helicopter_x": helicopter_x,

        "helicopter_y": helicopter_y,

        "water": water,

        "max_water": max_water,

        "score": score,

        "health": health,

        "max_health": max_health,

        "turn": turn,

        "fire_age": {

            str(position): age

            for position, age in fire_age.items()

        },

        "weather": weather,

        "extinguished_fires": extinguished_fires

    }

    with open("savegame.json", "w", encoding="utf-8") as file:

        json.dump(game_data, file, ensure_ascii=False)

    print("💾 Игра сохранена!")

# Загрузка игры

def load_game():

    global field

    global helicopter_x

    global helicopter_y

    global water

    global max_water

    global score

    global health

    global max_health

    global turn

    global fire_age

    global weather

    global extinguished_fires

    try:

        with open("savegame.json", "r", encoding="utf-8") as file:

            game_data = json.load(file)

        field = game_data["field"]

        helicopter_x = game_data["helicopter_x"]

        helicopter_y = game_data["helicopter_y"]

        water = game_data["water"]

        max_water = game_data["max_water"]

        score = game_data["score"]

        health = game_data["health"]

        max_health = game_data["max_health"]

        turn = game_data["turn"]

        fire_age = {}

        for key, value in game_data["fire_age"].items():

            coordinates = key.strip("()").split(",")

            x = int(coordinates[0])

            y = int(coordinates[1])

            fire_age[(x, y)] = value

        weather = game_data["weather"]

        extinguished_fires = game_data["extinguished_fires"]

        print("📂 Игра загружена!")

    except FileNotFoundError:

        print("❌ Сохранённая игра не найдена.")

# Создание поля

def create_field(width, height):
    return [["🌿" for _ in range(width)] for _ in range(height)]

# Генерация реки

def generate_river(field):
    height = len(field)
    width = len(field[0])

    # Количество небольших рек
    river_count = 5

    for _ in range(river_count):
        x = random.randint(0, width - 1)
        y = random.randint(0, height - 1)

        # Размер небольшой реки
        length = random.randint(3, 6)

        for _ in range(length):
            if is_inside(x, y, width, height):
                field[y][x] = "🌊"

            # Река случайно меняет направление
            direction = random.choice([
                "up",
                "down",
                "left",
                "right"
            ])

            if direction == "up":
                y -= 1
            elif direction == "down":
                y += 1
            elif direction == "left":
                x -= 1
            else:
                x += 1

# Генерация деревьев

def generate_random_cells(field, count):
    height = len(field)
    width = len(field[0])

    cells = []

    while len(cells) < count:
        x = random.randint(0, width - 1)
        y = random.randint(0, height - 1)

        if field[y][x] == "🌿" and (x, y) not in cells:
            cells.append((x, y))

    return cells

def generate_trees(field, count):
    cells = generate_random_cells(field, count)

    for x, y in cells:
        field[y][x] = "🌲"

# Рост новых деревьев

def grow_trees(field):

    empty_cells = []

    for y in range(len(field)):

        for x in range(len(field[0])):

            if field[y][x] == "🌿":

                empty_cells.append((x, y))

    if empty_cells:

        if random.random() < 0.5:

            x, y = random.choice(empty_cells)

            field[y][x] = "🌲"

            print("🌳 В лесу выросло новое дерево!")

# Случайное появление пожара

def create_fire(field, fire_age):

    trees = []

    for y in range(len(field)):

        for x in range(len(field[0])):

            if field[y][x] == "🌲":

                trees.append((x, y))

    if trees:

        x, y = random.choice(trees)

        field[y][x] = "🔥"

        fire_age[(x, y)] = 0

        print("🔥 В лесу начался пожар!")

# Распространение пожара

def spread_fire(field, fire_age):

    height = len(field)

    width = len(field[0])

    burning_trees = []

    for y in range(height):

        for x in range(width):

            if field[y][x] == "🔥":

                burning_trees.append((x, y))

    for x, y in burning_trees:

        neighbors = [

            (x - 1, y),

            (x + 1, y),

            (x, y - 1),
            (x, y + 1)

        ]

        for nx, ny in neighbors:

            if is_inside(nx, ny, width, height):

                if field[ny][nx] == "🌲":

                    if random.random() < 0.3:

                        field[ny][nx] = "🔥"

                        fire_age[(nx, ny)] = 0

                        print(

                            "🔥 Огонь распространился "

                            "на соседнее дерево!"

                        )

# Сгорание деревьев

def burn_trees(field, fire_age):
    global score

    burned = []

    for position in list(fire_age.keys()):

        x, y = position

        if field[y][x] == "🔥":

            fire_age[position] += 1

            # Через 12 ходов дерево полностью сгорает

            if fire_age[position] >= 12:

                field[y][x] = "🌑"

                burned.append(position)

                score -= 5

                print("🌑 Дерево сгорело! -5 очков.")

    for position in burned:

        del fire_age[position]

# Отображение поля

def show_field(field, helicopter_x, helicopter_y, clouds):

    for y in range(len(field)):
        row = []

        for x in range(len(field[0])):

            if x == helicopter_x and y == helicopter_y:
                row.append("🚁")

            elif (x, y) in clouds:
                if "⛈️" in weather:
                    row.append("⛈️")
                else:
                    row.append("☁️")

            else:
                row.append(field[y][x])

        print(" ".join(row))


# Смена погоды

def generate_clouds(field):
    height = len(field)
    width = len(field[0])

    clouds = []

    # Количество облаков
    cloud_count = 3

    while len(clouds) < cloud_count:

        x = random.randint(0, width - 1)
        y = random.randint(0, height - 1)

        if field[y][x] == "🌿" and (x, y) not in clouds:
            clouds.append((x, y))

    return clouds

def change_weather():

    weather_number = random.randint(1, 3)

    if weather_number == 1:

        return "☀️  Ясно"

    elif weather_number == 2:

        return "🌧️  Дождь"

    else:

        return "⛈️  Гроза"

# Размер поля

width = int(input("Введите ширину поля: "))

height = int(input("Введите высоту поля: "))

# Создание поля

field = create_field(width, height)

generate_river(field)

generate_trees(field, (width * height) // 4)


# Случайное размещение госпиталя

hospital_cells = generate_random_cells(field, 1)
hospital_x, hospital_y = hospital_cells[0]
field[hospital_y][hospital_x] = "🏥"


# Случайное размещение магазина

shop_cells = generate_random_cells(field, 1)
shop_x, shop_y = shop_cells[0]
field[shop_y][shop_x] = "🛒"

# Положение вертолёта

helicopter_x = 0

helicopter_y = 0

# Вода

water = 0

max_water = 1

# Очки

score = 0

# Здоровье вертолёта

health = 3

max_health = 3

# Ход

turn = 0

# Возраст каждого пожара

fire_age = {}

# Погода

weather = "☀️  Ясно"

# Облака

clouds = []

# Количество потушенных пожаров

extinguished_fires = 0

# Основной игровой цикл

while True:

    print("\n" * 2)

    print("================================")

    print("          ИГРА: ПОЖАР")

    print("================================")

    print(f"🏆 Очки: {score}")

    print(f"🔥 Потушено пожаров: {extinguished_fires}/5")

    print(f"💧 Вода: {water}/{max_water}")

    print(f"❤️  Здоровье: {health}/{max_health}")

    print(f"🌦️  Погода: {weather}")

    print(f"Ход: {turn}")

    print()

    show_field(
        field,
        helicopter_x,
        helicopter_y,
        clouds

    )

    print()

    print("Управление:")

    print("W - вверх")

    print("S - вниз")

    print("A - влево")

    print("D - вправо")

    print("E - набрать воду")

    print("F - потушить пожар")

    print("H - восстановить здоровье в больнице")

    print("B - купить улучшение резервуара в магазине")

    print("K - сохранить игру")

    print("L - загрузить игру")

    print("Q - выйти")

    command = input("Введите команду: ").lower()

    # Движение вверх

    if command == "w":

        if is_inside(

            helicopter_x,

            helicopter_y - 1,

            width,

            height

        ):

            helicopter_y -= 1

    # Движение вниз

    elif command == "s":

        if is_inside(

            helicopter_x,

            helicopter_y + 1,

            width,

            height

        ):

            helicopter_y += 1

    # Движение влево

    elif command == "a":

        if is_inside(

            helicopter_x - 1,

            helicopter_y,

            width,

            height

        ):

            helicopter_x -= 1

    # Движение вправо

    elif command == "d":

        if is_inside(

            helicopter_x + 1,

            helicopter_y,

            width,

            height

        ):

            helicopter_x += 1

    # Набрать воду

    elif command == "e":
        if field[helicopter_y][helicopter_x] == "🌊":

            if water < max_water:

                water = max_water

                print("💧 Вертолёт набрал воду!")

            else:

                print("Резервуар уже полный.")

        else:

            print(

                "Чтобы набрать воду, "

                "нужно находиться над водой."

            )

    # Потушить пожар

    elif command == "f":

        if field[helicopter_y][helicopter_x] == "🔥":

            if water > 0:

                field[helicopter_y][helicopter_x] = "🌿"

                water -= 1

                score += 10

                extinguished_fires += 1

                position = (

                    helicopter_x,

                    helicopter_y

                )

                if position in fire_age:

                    del fire_age[position]

                print(

                    "💧 Пожар потушен! "

                    "+10 очков."

                )

            else:

                print("В резервуаре нет воды!")

        else:

            print("Здесь нет пожара.")

    # Восстановить здоровье

    elif command == "h":

        if field[helicopter_y][helicopter_x] == "🏥":

            if health < max_health:

                if score >= 10:

                    score -= 10

                    health += 1

                    print(

                        "🏥 Здоровье восстановлено! "

                        "-10 очков, +1 ❤️"

                    )

                else:

                    print(

                        "Недостаточно очков. "

                        "Нужно 10."

                    )

            else:

                print(

                    "❤️ Здоровье уже максимальное."

                )

        else:

            print(

                "🏥 Чтобы восстановить здоровье, "

                "нужно находиться в больнице."

            )

    # Магазин

    elif command == "b":

        if field[helicopter_y][helicopter_x] == "🛒":

            if score >= 20:

                score -= 20

                max_water += 1

                print(

                    "🛒 Резервуар улучшен! "

                    f"Теперь вместимость: "

                    f"{max_water} 💧"

                )

            else:

                print(

                    "Недостаточно очков. "

                    "Нужно 20."

                )

        else:

            print(

                "🛒 Чтобы купить улучшение, "

                "нужно находиться в магазине."

            )

    # Сохранение игры

    elif command == "k":

        save_game()

    # Загрузка игры

    elif command == "l":

        load_game()

    # Выход

    elif command == "q":

        print("Игра завершена.")

        break

    # Неизвестная команда

    else:

        print("Неизвестная команда.")

    # Новый ход

    turn += 1

    # Проверка победы

    if extinguished_fires >= 5:

        print()

        print("================================")

        print("🏆 ПОБЕДА!")

        print("================================")

        print("Ты успешно потушила 5 пожаров!")

        print(f"Итоговый счёт: {score}")

        print("🌲 Лес спасён!")

        break

    # Каждые 5 ходов меняется погода

    if turn % 5 == 0:

        weather = change_weather()

        print(

            f"🌦️  Погода изменилась: "

            f"{weather}"

        )

        if "🌧️" in weather or "⛈️" in weather:
         clouds = generate_clouds(field)
    else:
        clouds = []

    # Если гроза — есть шанс появления пожара

    if "⛈️" in weather:

        if random.random() < 0.3:

            create_fire(

                field,

                fire_age

            )

            print(

                "⚡ Молния вызвала пожар!"

            )

    # Урон вертолёту от огня

    if field[helicopter_y][helicopter_x] == "🔥":

        health -= 1

        print(

            "🔥 Вертолёт попал в огонь! "

            "-1 ❤️"

        )

        if health <= 0:

            print(

                "💥 Вертолёт получил "

                "слишком много повреждений!"

            )

            print("Игра окончена.")

            break

        # Старые пожары постепенно сгорают

    burn_trees(

        field,

        fire_age

    )

    # Каждые 5 ходов появляется новый пожар

    if turn % 5 == 0:

        create_fire(

            field,

            fire_age

        )

    # Каждые 4 хода растут новые деревья

    if turn % 4 == 0:

        grow_trees(field)

    # В дождь огонь распространяется медленнее

    if "🌧️" in weather:

        if turn % 4 == 0:

            spread_fire(

                field,

                fire_age

            )

    else:

        if turn % 3 == 0:

            spread_fire(

                field,

                fire_age

            )

    # Небольшая пауза перед следующим ходом

    time.sleep(1)