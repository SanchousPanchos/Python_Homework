def factorial(number):
    result = 1

    for i in range(1, number + 1):
        result *= i

    return result

n = int(input("Введите натуральное число: "))

fact = factorial(n)

factorials = []

for i in range(fact, 0, -1):
    factorials.append(factorial(i))

print(fact)
print(factorials)